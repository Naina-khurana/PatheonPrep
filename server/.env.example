# Copy to server/.env (never committed). Every value is optional except GROQ_API_KEY.

# Groq hosts Whisper with a free tier. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# whisper-large-v3 is the most accurate on fast, jargon-heavy speech.
# whisper-large-v3-turbo is faster and cheaper if accuracy is good enough.
GROQ_WHISPER_MODEL=whisper-large-v3

PORT=8787
# Where signed upload and playback links point. Must be reachable from the browser.
PUBLIC_BASE_URL=http://localhost:8787
# The frontend's origin(s), comma separated, for CORS.
WEB_ORIGIN=http://localhost:5173

# Uploaded files, extracted audio, transcripts and the review database live here.
DATA_DIR=data
# Signs upload and playback links. Random per boot if unset (links break on restart).
SIGNING_SECRET=

# Paths to the tools if they aren't on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

# A review that takes longer than this fails instead of hanging.
JOB_TIMEOUT_MS=600000
