# Copy to server/.env (never committed). Every value is optional except GROQ_API_KEY.

# Groq hosts Whisper with a free tier. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# whisper-large-v3 is the most accurate on fast, jargon-heavy speech.
# whisper-large-v3-turbo is faster and cheaper if accuracy is good enough.
GROQ_WHISPER_MODEL=whisper-large-v3

PORT=8787
# Where signed upload and playback links point. Must be reachable from the browser.
PUBLIC_BASE_URL=http://localhost:8787
# The frontend's origin(s), comma separated, for CORS.
WEB_ORIGIN=http://localhost:5173

# Uploaded files, extracted audio, transcripts and the review database live here.
DATA_DIR=data
# Signs upload and playback links. Random per boot if unset (links break on restart).
SIGNING_SECRET=

# Paths to the tools if they aren't on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

# A review that takes longer than this fails instead of hanging.
JOB_TIMEOUT_MS=600000

# "Your feedback is ready" emails go through Resend (https://resend.com/api-keys).
# With either value empty, emails are written to the server log instead of sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Video Review <feedback@example.com>"
EMAIL_FROM=
# Where the link in the email points. Defaults to the first WEB_ORIGIN.
APP_URL=

# AI judge. Select an OpenAI-compatible chat model with JSON mode.
# The default endpoint uses Groq and can reuse GROQ_API_KEY.
# A custom endpoint requires its own JUDGE_API_KEY.
JUDGE_ENDPOINT=
JUDGE_MODEL=
JUDGE_API_KEY=
# Optional path to the team rubric text. Keep private source documents outside git.
JUDGE_RUBRIC_FILE=
# Optional per-speech rubric map. Map exact picker names to rubric text. Example keys: {"Public Forum":{"Rebuttal":"..."}}
JUDGE_RUBRICS_JSON=
